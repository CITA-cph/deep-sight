<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<PropertyGroup Label="UserMacros">
		<VcpkgRoot>C:\vcpkg</VcpkgRoot>
		<VcpkgTriplet>x64-windows-static</VcpkgTriplet>
		<OpenVdbLibDir></OpenVdbLibDir>
	</PropertyGroup>

	<PropertyGroup>
		<VcpkgInstalled>$(VcpkgRoot)\installed\$(VcpkgTriplet)</VcpkgInstalled>
		<DeepSightIncludes>$(VcpkgInstalled)\include;$(VcpkgInstalled)\include\eigen3</DeepSightIncludes>
		<DeepSightLibDirs Condition="'$(Configuration)'=='Release'">$(VcpkgInstalled)\lib;$(OpenVdbLibDir)</DeepSightLibDirs>
		<DeepSightLibDirs Condition="'$(Configuration)'=='Debug'">$(VcpkgInstalled)\debug\lib;$(OpenVdbLibDir)</DeepSightLibDirs>
	</PropertyGroup>

	<ItemDefinitionGroup>
		<ClCompile>
			<AdditionalIncludeDirectories>$(DeepSightIncludes);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
		</ClCompile>
		<Link>
			<AdditionalLibraryDirectories>$(DeepSightLibDirs);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
		</Link>
	</ItemDefinitionGroup>

	<ItemGroup>
		<BuildMacro Include="VcpkgRoot">
			<Value>$(VcpkgRoot)</Value>
		</BuildMacro>
		<BuildMacro Include="VcpkgTriplet">
			<Value>$(VcpkgTriplet)</Value>
		</BuildMacro>
	</ItemGroup>

</Project>